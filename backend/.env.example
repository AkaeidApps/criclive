# Cricket Database provider credentials. NEVER commit the real key or place it in Flutter.
CDB_KEY=YOUR_CRICKET_DATABASE_API_KEY
CDB_BASE_URL=https://api.cricketdatabase.com/v1
CDB_PLAN=free

# Application server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Provider budget (matches the documented free plan: 50/day, 10/minute)
DAILY_REQUEST_LIMIT=50
PER_MINUTE_LIMIT=10
CACHE_TTL_SECONDS=300

# Optional persistence. Leave empty for in-memory development.
DATABASE_URL=
REDIS_URL=
ENABLE_PERSISTENCE=false
